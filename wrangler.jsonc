{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "basics-template", // the Worker's name in Cloudflare: one per site
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // Apex only. www stays a proxied DNS record so the Cloudflare www -> apex redirect rule keeps firing.
  "routes": [{ "pattern": "example.com", "custom_domain": true }]
}
