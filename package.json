{
  "name": "basics-template",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "preview": "wrangler dev",
    "images": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/make-images.mts",
    "check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-config.mts",
    "deploy": "npm run check && npm run build && wrangler deploy",
    "test": "vitest run",
    "test:e2e": "next build && playwright test"
  },
  "dependencies": {
    "next": "14.2.35",
    "react": "^18",
    "react-dom": "^18"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "jsdom": "^29.1.1",
    "typescript": "^5",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  }
}
